---
const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
---

<div class="masthead">
  {
    isHome && (
      <svg class="trail" aria-hidden="true" viewBox="0 0 1440 520" preserveAspectRatio="xMaxYMin meet">
        <path
          d="M300 -20 C340 120 470 130 520 60 C580 -20 650 40 640 150 C630 260 760 300 820 210 C880 120 800 40 880 20 C960 0 1000 120 980 230 C960 340 1080 380 1140 290 C1200 200 1150 90 1230 70 C1320 50 1360 160 1460 140"
          fill="none"
          stroke="currentColor"
          stroke-width="30"
          stroke-linecap="round"></path>
      </svg>
    )
  }
  <header class="banner">
    <a href="#main" class="skip-link visually-hidden-focusable">Skip to content</a>

    <a href="/" class="logo">Dan Matthew</a>

    <nav aria-label="Main">
      <a href="/#services">Services</a>
      {
        currentPath.startsWith("/notes") ? (
          <a href="/notes" aria-current="page">
            Notes
          </a>
        ) : (
          <a href="/notes">Notes</a>
        )
      }
      <a href="https://photos.danmatthew.co.uk" rel="me external">Photography</a>
      <a href="#contact" class="button button--solid">Get in touch</a>
    </nav>
  </header>
</div>

<style>
  .masthead {
    position: relative;
  }

  .trail {
    position: absolute;
    top: -40px;
    right: 0;
    width: min(100%, 1100px);
    height: auto;
    color: var(--cream);
    pointer-events: none;
  }

  .banner {
    position: relative;
    max-width: 80rem;
    margin-inline: auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
    justify-content: space-between;
  }

  .skip-link {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.75rem 1.125rem;
    border-radius: var(--radius-pill);
    background: var(--cream);
    color: var(--ultramarine);
    font-weight: 700;
    text-decoration: none;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    align-items: center;
    padding: 0.375rem 0.375rem 0.375rem 1.375rem;
    border-radius: var(--radius-pill);
    background: var(--ultramarine);
    font-size: 1rem;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  nav .button {
    min-height: 48px;
    padding-inline: 1.375rem;
  }

  @media (max-width: 40em) {
    nav {
      padding-inline-start: 0;
    }
  }
</style>
