---

---
<section class="contact-cta">
  <hgroup>
    <h2>Get in touch</h2>
    <p>Have a project in mind or want to chat about accessibility? Drop me a message.</p>
  </hgroup>
  <form
    name="contact"
    method="POST"
    data-netlify="true"
    action="/"
    netlify-honeypot="bot-field"
    novalidate
  >
    <div>
      <label for="name">What’s your name?</label>
      <input
        type="text"
        id="name"
        name="name"
        autocomplete="name"
        required
        autocapitalize="off"
        autocorrect="off"
      />
    </div>
    <div>
      <label for="email">What’s your email address?</label>
      <input
        type="email"
        id="email"
        name="email"
        autocomplete="email"
        required
        autocapitalize="off"
        autocorrect="off"
      />
    </div>
    <div>
      <label for="message">What’s on your mind?</label>
      <textarea
        required
        autocapitalize="sentences"
        spellcheck="true"
        name="message"
        id="message"></textarea>
    </div>
    <div hidden>
      <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
    </div>
    <button type="submit" class="form-button">Send message</button>
  </form>
</section>
<style>
  .contact-cta {
    container-type: inline-size;
  }

  hgroup {
    margin-bottom: 1.5rem;
  }

  hgroup p {
    margin-top: 0.25em;
  }

  form div + div {
    margin-top: 1.5em;
  }

  label {
    display: block;
    margin-bottom: 0.5em;
    line-height: 1;
  }

  input, textarea {
    box-sizing: border-box;
    display: block;
    width: 100%;
    border: 2px solid var(--accent);
    border-radius: 0.25rem;
    padding: 0.25em 0.5em;
    font-family: inherit;
    font-size: max(16px, 1em);
  }

  textarea {
    min-height: 8em;
    resize: vertical;
  }

  .form-button {
    margin-top: 1.5em;
    border: none;
    background-color: var(--accent);
    color: #fff;
    font-family: inherit;
    font-size: 1.125rem;
    padding: 0.5em 1.25em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--border-radius, 0.25rem);
    min-width: 10ch;
    min-height: 44px;
    text-align: center;
    line-height: 1;
    transition: 180ms all ease-in-out;
  }

  .form-button:hover,
  .form-button:focus {
    outline-style: solid;
    outline-color: transparent;
    box-shadow: 0 0 0 0.05em var(--accent), 0 0 0.15em 0.15em var(--accent);
  }

  @media (forced-colors: active) {
    .form-button {
      border: 2px solid ButtonText;
    }
  }

  :is(input, textarea):focus {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: 0 0 0.35em -0.1em var(--accent);
  }
</style>
