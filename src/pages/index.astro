  <!-- <div class="wrapper--quotes">
      <section class="quotes">
        <hgroup class="flow">
          <h2>Quotes</h2>
          <p>Some nice things people have said about me</p>
        </hgroup>
        <div class="quote-container js-at-start">
          <div class="quote-scroller" tabindex="0">
            {quotes.items.map((quote) => <Quote quote={quote} />)}
          </div>
        </div>
      </section>
    </div> -->
</HomeLayout>

<style>
  .intro,
  .services,
  .photos,
  .notes {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .intro {
    padding-block: clamp(3rem, 12vw, 10rem) clamp(4rem, 10vw, 7.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 4rem;
    align-items: flex-end;
  }

  .intro__copy {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .intro__mark {
    width: 76px;
    height: 76px;
    fill: var(--flame);
  }

  .eyebrow {
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--coral);
  }

  h1 {
    max-width: none;
    font-size: clamp(2.75rem, 5.6vw, 5.25rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }

  h1 em {
    color: var(--apricot);
  }

  .caret {
    display: inline-block;
    width: 0.09em;
    height: 0.92em;
    margin-inline-start: 0.1em;
    vertical-align: -0.1em;
    background: var(--flame);
  }

  .intro__lede {
    max-width: 38ch;
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
    line-height: 1.6;
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .intro__figure {
    flex: 1 1 360px;
    min-width: 0;
  }

  .arch {
    position: relative;
    height: var(--arch-height, 560px);
    border-radius: var(--radius-arch);
    overflow: hidden;
  }

  .arch--framed {
    border: 6px solid var(--cream);
  }

  .arch svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cream {
    background: var(--cream);
    color: var(--ultramarine);
    border-radius: 3rem 3rem 0 0;
  }

  .cream a {
    color: var(--ultramarine);
  }

  .cream a:hover {
    color: var(--rust);
  }

  .services {
    padding-block: 6.5rem;
  }

  .services__head {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 4rem;
    align-items: flex-end;
    justify-content: space-between;
    margin-block-end: 3.5rem;
  }

  .services h2 {
    max-width: 16ch;
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    line-height: 1.08;
  }

  .services__head p {
    max-width: 42ch;
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .hash {
    color: var(--rust);
  }

  .services__list {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    border-top: 3px solid var(--ultramarine);
  }

  .services__list li {
    padding: 2.25rem 2rem 2.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .services__number {
    font-size: 3.5rem;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--rust);
  }

  .services h3 {
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }

  .services__list p {
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .photos {
    padding-block-end: 7.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-end;
  }

  .photos__copy {
    flex: 1 1 260px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block-end: 0.75rem;
  }

  .photos h2 {
    font-size: 2.25rem;
    font-style: italic;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .photos__copy p {
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .photos__copy a {
    font-weight: 700;
  }

  .photos .arch {
    flex: 1 1 220px;
    min-width: 0;
    border-radius: 999px 999px 1.5rem 1.5rem;
  }

  .notes {
    padding-block: 7rem;
  }

  .notes__head {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: baseline;
    justify-content: space-between;
    margin-block-end: 2rem;
  }

  .notes h2 {
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    line-height: 1;
  }

  .notes .hash {
    color: var(--coral);
  }

  .notes__head a {
    font-weight: 700;
  }

  .notes__list {
    margin: 0;
    border-bottom: 2px solid var(--border);
  }

  .notes__list li {
    padding-block: 1.625rem;
    border-top: 2px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    align-items: baseline;
  }

  .notes__list time {
    flex: 0 0 140px;
    font-size: 0.9375rem;
    color: var(--coral);
  }

  .notes__list a {
    flex: 1 1 400px;
    font-size: 1.625rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
</style>
