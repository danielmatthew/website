---
import { getCollection } from "astro:content";
import { contentfulClient } from "../lib/contentful";

import shuffle from "../utils/shuffle";

import HomeLayout from "../layouts/HomeLayout.astro";
import Quote from "../components/Quote.astro";

const notesWithDate = (
  await getCollection("posts", ({ data }) => {
    return data.published !== false;
  })
)
  .sort((a, b) => {
    return b.data.publishedDate?.valueOf() - a.data.publishedDate?.valueOf();
  })
  .slice(0, 3);

const projects = await getCollection("work", ({ data }) => {
  return data.draft !== true;
});

const quotes = await contentfulClient
  .getEntries({
    content_type: "testimonial",
  })
  .then((response) => {
    return {
      items: shuffle(response.items),
    };
  });

const services = [
  {
    title: "Processes",
    body: "From discovery to QA: practical checkpoints and definitions of done that make accessibility routine.",
  },
  {
    title: "Systems",
    body: "Design system tokens, components and guidance that ship accessible by default, so every product inherits it.",
  },
  {
    title: "Teams",
    body: "Workshops, pairing and coaching that build confidence with assistive tech, testing and inclusive design.",
  },
];
---

<HomeLayout>
  <section class="intro" aria-labelledby="intro-h">
    <div class="intro__copy">
      <svg class="intro__mark" aria-hidden="true" viewBox="0 0 100 100">
        <g transform="translate(50 50)">
          <rect x="-9" y="-46" width="18" height="40" rx="3"></rect>
          <rect x="-9" y="-46" width="18" height="40" rx="3" transform="rotate(72)"></rect>
          <rect x="-9" y="-46" width="18" height="40" rx="3" transform="rotate(144)"></rect>
          <rect x="-9" y="-46" width="18" height="40" rx="3" transform="rotate(216)"></rect>
          <rect x="-9" y="-46" width="18" height="40" rx="3" transform="rotate(288)"></rect>
          <circle r="12"></circle>
        </g>
      </svg>
      <p class="eyebrow">Accessibility &amp; design systems consultant</p>
      <h1 id="intro-h">
        Accessibility, built into the way <em>your teams</em> already work.<span class="caret" aria-hidden="true"></span>
      </h1>
      <p class="intro__lede">I help organisations embed accessibility within processes, systems, and teams.</p>
      <div class="intro__actions">
        <a href="#contact" class="button button--solid">Start a conversation →</a>
        <a href="#services" class="button">What I do</a>
      </div>
    </div>
    <figure class="intro__figure">
      <div class="arch arch--framed">
        <svg aria-hidden="true" viewBox="0 0 360 560" preserveAspectRatio="none">
          <rect width="360" height="560" fill="var(--sand)"></rect>
          <circle cx="180" cy="230" r="70" fill="var(--flame)"></circle>
          <path d="M0 300 C60 260 110 290 170 250 C230 210 290 270 360 240 L360 560 L0 560Z" fill="var(--ultramarine-light)"></path>
          <path d="M0 380 C80 350 150 380 220 345 C280 318 330 350 360 340 L360 560 L0 560Z" fill="var(--ultramarine-mid)"></path>
          <path d="M0 460 C100 430 190 470 280 440 C320 428 345 435 360 430 L360 560 L0 560Z" fill="var(--ultramarine-deep)"></path>
        </svg>
      </div>
    </figure>
  </section>

  <div class="cream">
    <section id="services" class="services" aria-labelledby="services-h">
      <div class="services__head">
        <h2 id="services-h"><span class="hash" aria-hidden="true">#</span> Accessibility in three places</h2>
        <p>Lasting accessibility isn't a one-off audit. It's how your work gets done, what it's built from, and who's doing it.</p>
      </div>
      <ol class="services__list" role="list">
        {
          services.map((service, index) => (
            <li>
              <span class="services__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h3>{service.title}</h3>
              <p>{service.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="photos" aria-labelledby="photos-h">
      <div class="photos__copy">
        <h2 id="photos-h">Off the clock</h2>
        <p>I walk long distances and photograph the landscapes along the way.</p>
        <a href="https://photos.danmatthew.co.uk" rel="me external">See the photographs →</a>
      </div>
      <div class="arch" style="--arch-height: 420px">
        <svg aria-hidden="true" viewBox="0 0 220 420" preserveAspectRatio="none">
          <rect width="220" height="420" fill="var(--sand)"></rect>
          <path d="M0 220 C50 190 110 230 220 180 L220 420 L0 420Z" fill="var(--ultramarine-light)"></path>
          <path d="M0 300 C70 280 140 310 220 285 L220 420 L0 420Z" fill="var(--ultramarine-deep)"></path>
        </svg>
      </div>
      <div class="arch" style="--arch-height: 320px">
        <svg aria-hidden="true" viewBox="0 0 220 320" preserveAspectRatio="none">
          <rect width="220" height="320" fill="var(--peach)"></rect>
          <circle cx="150" cy="120" r="34" fill="var(--flame)"></circle>
          <path d="M0 190 C60 160 130 200 220 170 L220 320 L0 320Z" fill="var(--ultramarine-mid)"></path>
        </svg>
      </div>
      <div class="arch" style="--arch-height: 480px">
        <svg aria-hidden="true" viewBox="0 0 220 480" preserveAspectRatio="none">
          <rect width="220" height="480" fill="var(--mist)"></rect>
          <path d="M0 250 C40 210 100 260 160 215 C190 195 210 205 220 200 L220 480 L0 480Z" fill="var(--ultramarine-light)"></path>
          <path d="M0 350 C80 320 150 360 220 335 L220 480 L0 480Z" fill="var(--ultramarine-deep)"></path>
        </svg>
      </div>
    </section>
  </div>

  <section id="notes" class="notes" aria-labelledby="notes-h">
    <div class="notes__head">
      <h2 id="notes-h"><span class="hash" aria-hidden="true">#</span> Notes</h2>
      <a href="/notes">All notes →</a>
    </div>
    <ol class="notes__list" role="list">
      {
        notesWithDate.map((note) => (
          <li>
            <time datetime={note.data.publishedDate.toISOString().slice(0, 10)}>
              {note.data.publishedDate.toISOString().slice(0, 10)}
            </time>
            <a href={`/notes/${note.id}`}>{note.data.title}</a>
          </li>
        ))
      }
    </ol>
  </section>

