        {
          projects.map((project) => (
            <li class="card card--project">
              <div class="project-listing">
                <div class="card__cover">
                  <div class="thumb-grid">
                    {[...Array(9)].map(() => (
                      <div class="thumb-grid__thumb">
                        <img
                          src={project.data.img}
