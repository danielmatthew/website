---
import { getPublishedArticles } from "../lib/collections";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import FormattedDate from "../components/FormattedDate.astro";

const articles = await getPublishedArticles();
---
<BaseLayout title="Articles">
  <Hero title="Articles" />
  <ol class="content flow posts" style="--flow-space: var(--space-m);" role="list" reversed>
    {
      articles.map((article) => (
        <li>
          <a href={`/articles/${article.id}`}>{article.data.title}</a>
          <FormattedDate date={article.data.publishedDate} class="meta" />
        </li>
      ))
    }
  </ol>
</BaseLayout>
