---
import { getPublishedPosts } from "../lib/collections";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import FormattedDate from "../components/FormattedDate.astro";

const posts = await getPublishedPosts();
---
<BaseLayout title="Notes">
  <Hero title="Notes" />
  <ol class="content flow posts" style="--flow-space: var(--space-m);" role="list" reversed>
    {
      posts.map((post) => (
        <li>
          <a href={`/notes/${post.id}`}>{post.data.title}</a>
          <FormattedDate date={post.data.publishedDate} class="meta" />
        </li>
      ))
    }
  </ol>
</BaseLayout>
