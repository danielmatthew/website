---
import { getPublishedPosts } from "../lib/collections";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import PostList from "../components/PostList.astro";

const posts = await getPublishedPosts();
const pinned = posts.filter((post) => post.data.pinned);
const evergreen = posts.filter((post) => post.data.evergreen && !post.data.pinned);
const rest = posts.filter((post) => !post.data.pinned);
---
<BaseLayout title="Notes">
  <Hero title="Notes">
    <p slot="header-extras">Browse by <a href="/notes/tags/">tag</a>.</p>
  </Hero>
  {
    pinned.length > 0 && (
      <section aria-labelledby="pinned-heading" class="flow">
        <h2 id="pinned-heading">Pinned</h2>
        <PostList posts={pinned} ordered={false} />
      </section>
    )
  }
  {
    evergreen.length > 0 && (
      <section aria-labelledby="evergreen-heading" class="flow">
        <h2 id="evergreen-heading">Start here</h2>
        <PostList posts={evergreen} ordered={false} />
      </section>
    )
  }
  <section aria-labelledby="all-heading" class="flow">
    <h2 id="all-heading">All notes</h2>
    <PostList posts={rest} />
  </section>
</BaseLayout>
