---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { getPublishedPosts } from "../../lib/collections";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Pagination from "../../components/Pagination.astro";
import PostTaxonomy from "../../components/PostTaxonomy.astro";
import OutdatedNotice from "../../components/OutdatedNotice.astro";

interface Props {
  entry: CollectionEntry<"posts">;
  prevPost: CollectionEntry<"posts"> | undefined;
  nextPost: CollectionEntry<"posts"> | undefined;
}

export async function getStaticPaths() {
  const notes = await getPublishedPosts();

  const numberOfPosts = notes.length;

  return notes.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prevPost: index + 1 === numberOfPosts ? undefined : notes[index + 1],
      nextPost: index === 0 ? undefined : notes[index - 1],
    },
  }));
}

const { entry, prevPost, nextPost } = Astro.props;
const { title, description, publishedDate, updatedDate, evergreen, category, tags, link } = entry.data;

const { Content } = await render(entry);
---

<BaseLayout title={title} description={description}>
  <article class="h-entry">
    <Hero title={title}>
      <div slot="header-extras">
        <div class="meta">
          <FormattedDate date={publishedDate} class="dt-published" />
          {
            evergreen && updatedDate && (
              <>
                · Last updated <FormattedDate date={updatedDate} class="dt-updated" />
              </>
            )
          }
        </div>
        <PostTaxonomy category={category} tags={tags} />
      </div>
    </Hero>
    {!evergreen && <OutdatedNotice date={updatedDate ?? publishedDate} />}
    {
      link && (
        <p class="post-link">
          <a class="u-bookmark-of" href={link} rel="external">{link}</a>
        </p>
      )
    }
    <section class="flow e-content">
      <Content />
    </section>
    <footer hidden>
      <data class="p-name" value={title}></data>
      <a class="u-url" href={`https://danmatthew.co.uk/notes/${entry.id}/`}></a>
      <div class="p-author h-card">
        <a class="u-url p-name" href="https://danmatthew.co.uk">Dan Matthew</a>
      </div>
      <a class="u-syndication" href="https://brid.gy/publish/mastodon" rel="syndication"></a>
      <a class="u-syndication" href="https://brid.gy/publish/bluesky" rel="syndication"></a>
    </footer>
  </article>
  <Pagination prev={prevPost} next={nextPost} basePath="notes" label="Notes pagination" />
</BaseLayout>
