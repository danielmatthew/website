{
  "name": "danmatthew.co.uk",
  "version": "7.1.0",
  "description": "",
  "main": "index.js",
  "devDependencies": {
    "@tinacms/cli": "^3.1.0",
    "@types/node": "^24.12.2",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "eslintConfig": {
    "extends": [
      "@open-wc/eslint-config",
      "eslint-config-prettier"
    ]
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "start": "astro start",
    "build": "tinacms build && astro build",
    "build:ci": "astro build",
    "preview": "astro preview",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "eslint --ext .js,.html . --ignore-path .gitignore",
    "lint:prettier": "prettier \"**/*.js\" --list-different || (echo '↑↑ these files are not prettier formatted ↑↑' && exit 1)",
    "format": "npm run format:eslint && npm run format:prettier",
    "format:eslint": "eslint --ext .js,.html . --fix --ignore-path .gitignore",
    "format:prettier": "prettier \"**/*.js\" --write",
    "test": "cypress run --spec \"cypress/integration/home_page.spec.js\"",
    "release": "npx standard-version && git push --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielmatthew/website.git"
  },
  "author": "Dan Matthew <hello@danmatthew.co.uk>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/danielmatthew/website/issues"
  },
  "homepage": "https://github.com/danielmatthew/website",
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@contentful/rich-text-html-renderer": "^16.6.10",
    "@georgedoescode/generative-utils": "^1.0.38",
    "@stackblitz/sdk": "^1.11.0",
    "@svgdotjs/svg.js": "^3.2.5",
    "@timohausmann/quadtree-js": "^1.2.6",
    "astro": "^7.3.3",
    "contentful": "^11.12.1",
    "eslint": "^9.39.4",
    "markdown-it": "^14.1.1",
    "sanitize-html": "^2.17.7",
    "tinacms": "^3.14.1"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
